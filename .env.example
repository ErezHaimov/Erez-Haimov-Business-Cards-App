PORT=8181
NODE_ENV=development

# Local MongoDB (if you have mongod running locally)
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/businessCardsApp

# MongoDB Atlas connection string - get this from your Atlas dashboard (Connect > Drivers)
MONGO_URI_ATLAS=mongodb+srv://<username>:<password>@<cluster-url>/businessCardsApp?retryWrites=true&w=majority

# Secret string used to sign JWT tokens - any long, random string
JWT_SECRET=replace-with-your-own-secret