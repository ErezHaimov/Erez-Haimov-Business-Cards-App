PORT=8181
NODE_ENV=development

# local mongo (אם יש לך mongod רץ מקומית)
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/businessCardsApp

# MongoDB Atlas connection string - קבל את זה מהדשבורד של Atlas (Connect > Drivers)
MONGO_URI_ATLAS=mongodb+srv://<username>:<password>@<cluster-url>/businessCardsApp?retryWrites=true&w=majority

# מחרוזת סודית לחתימת JWT - כל מחרוזת ארוכה ואקראית
JWT_SECRET=replace-with-your-own-secret